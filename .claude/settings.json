{
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(cargo test)",
      "Bash(cargo build)",
      "Grep",
      "Read"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-rust.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/cyrilphamle/Documents/Workspace/Navigator/navigator-back && cargo build 2>&1 && cargo test 2>&1"
          }
        ]
      }
    ]
  }
}
